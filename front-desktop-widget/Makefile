APP_NAME = TodoPlannerWidget
BUNDLE_ID = com.todoplanner.widget
BUILD_DIR = build
APP_BUNDLE = $(BUILD_DIR)/$(APP_NAME).app
CONTENTS = $(APP_BUNDLE)/Contents
MACOS_DIR = $(CONTENTS)/MacOS
RESOURCES = $(CONTENTS)/Resources
APP_EXECUTABLE = $(MACOS_DIR)/$(APP_NAME)

SOURCES = $(shell find Sources -name '*.swift' -type f | LC_ALL=C sort)
ARCH ?= $(shell uname -m)

# --- Environment Variable Loading ---
# Default to .env if ENV_FILE is not specified
ENV_FILE ?= .env

# Load environment variables from the file if it exists
ifneq (,$(wildcard $(ENV_FILE)))
    include $(ENV_FILE)
    export
endif

# Default values if not provided in the .env file
API_BASE_URL ?= http://localhost:8080
WEB_APP_BASE_URL ?= http://localhost:5173/todo-planner
STORAGE_MODE ?= remote
MOCK_SCHEDULE ?=

# Detect Swift compiler
SWIFTC := $(shell command -v swiftc 2> /dev/null)
ifndef SWIFTC
$(error Swift compiler not found. Install via Swiftly: curl -L https://swift-server.github.io/swiftly/swiftly-install.sh | bash)
endif

.PHONY: all clean run dev help test install build setup universal build-remote build-local build-mock build-weekend-mock dev-remote dev-local dev-mock dev-weekend-mock logs

help: ## Show this help message
	@echo "Todo Planner Desktop Widget - macOS Swift App"
	@echo ""
	@echo "Current Config (from $(ENV_FILE)):"
	@echo "  API_BASE_URL:     $(API_BASE_URL)"
	@echo "  WEB_APP_BASE_URL: $(WEB_APP_BASE_URL)"
	@echo "  STORAGE_MODE:     $(STORAGE_MODE)"
	@echo "  MOCK_SCHEDULE:    $(MOCK_SCHEDULE)"
	@echo ""
	@echo "Available targets:"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2}'

build: $(APP_EXECUTABLE) ## Build the application

all: $(APP_EXECUTABLE)

# Re-generate Config.swift if the ENV_FILE or the Makefile changes
Sources/Config.swift: $(ENV_FILE) Makefile
	@echo "Generating Config.swift..."
	@echo "// Auto-generated by Makefile - DO NOT EDIT" > Sources/Config.swift
	@echo "// Generated from $(ENV_FILE) at $$(date)" >> Sources/Config.swift
	@echo "" >> Sources/Config.swift
	@echo "struct BuildConfig {" >> Sources/Config.swift
	@echo "    static let apiBaseURL = \"$(API_BASE_URL)\"" >> Sources/Config.swift
	@echo "    static let webAppBaseURL = \"$(WEB_APP_BASE_URL)\"" >> Sources/Config.swift
	@echo "    static let storageMode = \"$(STORAGE_MODE)\"" >> Sources/Config.swift
	@echo "    static let mockSchedule = \"$(MOCK_SCHEDULE)\"" >> Sources/Config.swift
	@echo "}" >> Sources/Config.swift

$(APP_EXECUTABLE): $(SOURCES) Info.plist Sources/Config.swift
	@mkdir -p "$(MACOS_DIR)" "$(RESOURCES)"
ifeq ($(ARCH),universal)
	@echo "Building universal binary..."
	$(SWIFTC) -parse-as-library -o "$(MACOS_DIR)/$(APP_NAME)-arm64" -sdk $$(xcrun --show-sdk-path) -target arm64-apple-macosx14.0 $(SOURCES)
	$(SWIFTC) -parse-as-library -o "$(MACOS_DIR)/$(APP_NAME)-x86_64" -sdk $$(xcrun --show-sdk-path) -target x86_64-apple-macosx14.0 $(SOURCES)
	lipo -create -output "$(MACOS_DIR)/$(APP_NAME)" "$(MACOS_DIR)/$(APP_NAME)-arm64" "$(MACOS_DIR)/$(APP_NAME)-x86_64"
	@rm "$(MACOS_DIR)/$(APP_NAME)-arm64" "$(MACOS_DIR)/$(APP_NAME)-x86_64"
else
	@echo "Building for $(ARCH) (Storage: $(STORAGE_MODE))..."
	$(SWIFTC) -parse-as-library -o "$(MACOS_DIR)/$(APP_NAME)" -sdk $$(xcrun --show-sdk-path) -target $(ARCH)-apple-macosx14.0 $(SOURCES)
endif
	@cp Info.plist "$(CONTENTS)/"
	@plutil -replace CFBundleName -string "$(APP_NAME)" "$(CONTENTS)/Info.plist"
	@plutil -replace CFBundleIdentifier -string "$(BUNDLE_ID)" "$(CONTENTS)/Info.plist"
	@plutil -replace LSUIElement -bool YES "$(CONTENTS)/Info.plist"
	@echo "Built $(APP_BUNDLE)"

# --- Variant Targets ---

build-remote: ## Build using .env.remote
	$(MAKE) clean
	$(MAKE) build ENV_FILE=.env.remote

build-local: ## Build using .env.local
	$(MAKE) clean
	$(MAKE) build ENV_FILE=.env.local

dev-working-mock: ## Build and run in foreground (logs to terminal)
	$(MAKE) clean
	$(MAKE) build ENV_FILE=.env.working.mock
	@echo "Starting $(APP_NAME) in foreground..."
	@"$(APP_EXECUTABLE)"

dev-weekend-mock: ## Build and run weekend mock in foreground (logs to terminal)
	$(MAKE) clean
	$(MAKE) build ENV_FILE=.env.weekend.mock
	@echo "Starting $(APP_NAME) in foreground..."
	@"$(APP_EXECUTABLE)"

dev-remote: ## Build and run in foreground (logs to terminal)
	$(MAKE) build-remote
	@echo "Starting $(APP_NAME) in foreground..."
	@"$(APP_EXECUTABLE)"

dev-local: ## Build and run in foreground (logs to terminal)
	$(MAKE) build-local
	@echo "Starting $(APP_NAME) in foreground..."
	@"$(APP_EXECUTABLE)"

# --- Utility Targets ---

clean: ## Clean build artifacts
	@rm -rf $(BUILD_DIR)
	@rm -f Sources/Config.swift

install: all ## Install the app to /Applications
	@cp -r "$(APP_BUNDLE)" /Applications/

universal: ## Build universal binary (arm64 + x86_64)
	@$(MAKE) ARCH=universal all

logs: ## Stream application logs
	@echo "Streaming logs from $(BUNDLE_ID)..."
	@echo "Press Ctrl+C to stop"
	@log stream --level info --predicate 'subsystem == "$(BUNDLE_ID)"' --style compact

setup: ## Initial setup
	@command -v swiftc >/dev/null 2>&1 || { echo "Swift not found."; exit 1; }
	@xcode-select -p >/dev/null 2>&1 || xcode-select --install
	@echo "Setup complete!"
