# Makefile for Todo Planner Desktop Widget
# macOS Swift application using swiftc

APP_NAME = TodoPlannerWidget
BUNDLE_ID = com.todoplanner.widget
BUILD_DIR = build
APP_BUNDLE = $(BUILD_DIR)/$(APP_NAME).app
CONTENTS = $(APP_BUNDLE)/Contents
MACOS_DIR = $(CONTENTS)/MacOS
RESOURCES = $(CONTENTS)/Resources
APP_EXECUTABLE = $(MACOS_DIR)/$(APP_NAME)

SOURCES = $(shell find Sources -name '*.swift' -type f | LC_ALL=C sort)
ARCH ?= $(shell uname -m)

# Environment variables baked into the build
API_BASE_URL ?= http://localhost:8080
WEB_APP_BASE_URL ?= http://localhost:5173/todo-planner
# Note: Swift compiler flags don't support string values directly -> generate a config file instead.

# Detect Swift compiler (Swiftly or system)
SWIFTC := $(shell command -v swiftc 2> /dev/null)
SWIFT := $(shell command -v swift 2> /dev/null)

ifndef SWIFTC
$(error Swift compiler not found. Install via Swiftly: curl -L https://swift-server.github.io/swiftly/swiftly-install.sh | bash)
endif

.PHONY: all clean run dev help test install build

help: ## Show this help message
	@echo "Todo Planner Desktop Widget - macOS Swift App"
	@echo ""
	@echo "Available targets:"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2}'

build: $(APP_EXECUTABLE) ## Build the application

all: $(APP_EXECUTABLE) ## Build the application

Sources/Config.swift:
	@echo "Generating Config.swift with API_BASE_URL=$(API_BASE_URL) and WEB_APP_BASE_URL=$(WEB_APP_BASE_URL)..."
	@echo "// Auto-generated by Makefile - DO NOT EDIT" > Sources/Config.swift
	@echo "// Build time: $$(date)" >> Sources/Config.swift
	@echo "" >> Sources/Config.swift
	@echo "struct BuildConfig {" >> Sources/Config.swift
	@echo "    static let apiBaseURL = \"$(API_BASE_URL)\"" >> Sources/Config.swift
	@echo "    static let webAppBaseURL = \"$(WEB_APP_BASE_URL)\"" >> Sources/Config.swift
	@echo "}" >> Sources/Config.swift

$(APP_EXECUTABLE): $(SOURCES) Info.plist Sources/Config.swift
	@mkdir -p "$(MACOS_DIR)" "$(RESOURCES)"
	@echo "API_BASE_URL: $(API_BASE_URL)"
	@echo "WEB_APP_BASE_URL: $(WEB_APP_BASE_URL)"
ifeq ($(ARCH),universal)
	@echo "Building universal binary..."
	$(SWIFTC) \
		-parse-as-library \
		-o "$(MACOS_DIR)/$(APP_NAME)-arm64" \
		-sdk $$(xcrun --show-sdk-path) \
		-target arm64-apple-macosx14.0 \
		$(SOURCES)
	$(SWIFTC) \
		-parse-as-library \
		-o "$(MACOS_DIR)/$(APP_NAME)-x86_64" \
		-sdk $$(xcrun --show-sdk-path) \
		-target x86_64-apple-macosx14.0 \
		$(SOURCES)
	lipo -create -output "$(MACOS_DIR)/$(APP_NAME)" \
		"$(MACOS_DIR)/$(APP_NAME)-arm64" \
		"$(MACOS_DIR)/$(APP_NAME)-x86_64"
	@rm "$(MACOS_DIR)/$(APP_NAME)-arm64" "$(MACOS_DIR)/$(APP_NAME)-x86_64"
else
	@echo "Building for $(ARCH)..."
	$(SWIFTC) \
		-parse-as-library \
		-o "$(MACOS_DIR)/$(APP_NAME)" \
		-sdk $$(xcrun --show-sdk-path) \
		-target $(ARCH)-apple-macosx14.0 \
		$(SOURCES)
endif
	@cp Info.plist "$(CONTENTS)/"
	@plutil -replace CFBundleName -string "$(APP_NAME)" "$(CONTENTS)/Info.plist"
	@plutil -replace CFBundleDisplayName -string "$(APP_NAME)" "$(CONTENTS)/Info.plist"
	@plutil -replace CFBundleExecutable -string "$(APP_NAME)" "$(CONTENTS)/Info.plist"
	@plutil -replace CFBundleIdentifier -string "$(BUNDLE_ID)" "$(CONTENTS)/Info.plist"
	@plutil -replace LSUIElement -bool YES "$(CONTENTS)/Info.plist"
	@echo "✓ Built $(APP_BUNDLE) (menu bar app)"

run: all ## Build and run the application
	@echo "Launching $(APP_NAME)..."
	@open "$(APP_BUNDLE)"

dev: all ## Run in development mode (with console output)
	@echo "Running $(APP_NAME) in development mode..."
	@"$(APP_EXECUTABLE)"

clean: ## Clean build artifacts
	@echo "Cleaning build artifacts..."
	@rm -rf $(BUILD_DIR)
	@rm -f Sources/Config.swift
	@echo "✓ Clean complete"

test-prepare: ## Check if test API is available
	@echo "Checking test API availability..."
	@curl -sf http://localhost:8080/health >/dev/null 2>&1 || { \
		echo "Error: Test API not available at http://localhost:8080"; \
		echo "Start the API with: docker-compose up postgres api"; \
		exit 1; \
	}
	@echo "✓ Test API is running"

test-unit: ## Run all unit tests (no API required)
	@echo "Running all unit tests..."
	@mkdir -p build
	@$(SWIFTC) \
		-o build/all-tests \
		-sdk $$(xcrun --show-sdk-path) \
		-target $(ARCH)-apple-macosx14.0 \
		Tests/AllTests.swift \
		Sources/Models/*.swift \
		Sources/Services/APIClient.swift && \
	build/all-tests

test-integration: test-prepare ## Run integration tests against local API
	@echo "Running integration tests..."
	@mkdir -p build
	@export API_BASE_URL="http://localhost:8080" && \
		$(SWIFTC) \
			-o build/integration-tests \
			-sdk $$(xcrun --show-sdk-path) \
			-target $(ARCH)-apple-macosx14.0 \
			Tests/*.swift Sources/Models/*.swift Sources/Services/APIClient.swift && \
		build/integration-tests

test: test-unit ## Run all tests (models + state logic + transitions + mock API)

install: all ## Install the app to /Applications
	@echo "Installing to /Applications..."
	@cp -r "$(APP_BUNDLE)" /Applications/
	@echo "✓ Installed to /Applications/$(APP_NAME).app"

universal: ## Build universal binary (arm64 + x86_64)
	@$(MAKE) ARCH=universal all

logs: ## Stream application logs
	@echo "Streaming logs from $(BUNDLE_ID)..."
	@echo "Press Ctrl+C to stop"
	@log stream --level info --predicate 'subsystem == "$(BUNDLE_ID)"' --style compact

setup: ## Initial setup (check dependencies)
	@echo "Checking Swift toolchain..."
	@command -v swiftc >/dev/null 2>&1 || { \
		echo "Swift not found. Install via Swiftly:"; \
		echo "  curl -L https://swift-server.github.io/swiftly/swiftly-install.sh | bash"; \
		exit 1; \
	}
	@echo "Swift version: $$($(SWIFTC) --version | head -n1)"
	@echo ""
	@echo "Checking for Xcode Command Line Tools (for SDK)..."
	@xcode-select -p >/dev/null 2>&1 || xcode-select --install
	@echo "✓ Setup complete!"
	@echo ""
	@echo "Optional tools (install manually if needed):"
	@echo "  brew install swiftformat  # for code formatting"
	@echo "  brew install swiftlint    # for code linting"
