# Database connection string
# For local development with Docker Compose
DATABASE_URL=postgres://postgres:postgres@postgres:5432/todo_planner?sslmode=disable

# Server port (default: 8080)
PORT=8080

# JWT secret for token signing (use a strong random string in production)
JWT_SECRET=your-secret-key-change-this-in-production

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,http://localhost:8080
